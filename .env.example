# Copia este archivo como ".env.local" antes de ejecutar el proyecto

# Clave secreta para firmar los JWT (cámbiala en producción)
JWT_SECRET=cambia-esta-clave-super-secreta-en-produccion

# Tiempo de expiración del token
JWT_EXPIRES_IN=8h

# Cadena de conexión de tu proyecto Supabase (PostgreSQL)
# Supabase Dashboard -> Project Settings -> Database -> Connection string (URI)
# Usa el pooler transaccional (puerto 6543) para dev/serverless:
DATABASE_URL=postgresql://postgres.TU-PROYECTO:TU-PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require&pgbouncer=true