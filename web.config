<?xml version="1.0" encoding="utf-8"?>
<!--
  Arranque de Next.js en App Service Windows.
  El modulo iisnode (preinstalado en App Service) ejecuta server.js y le pasa
  las peticiones HTTP; server.js levanta el servidor real de Next.
-->
<configuration>
  <system.webServer>
    <handlers>
      <add name="iisnode" path="server.js" verb="*" modules="iisnode" />
    </handlers>
    <rewrite>
      <rules>
        <rule name="DynamicContent" stopProcessing="true">
          <match url=".*" />
          <action type="Rewrite" url="server.js" />
        </rule>
      </rules>
    </rewrite>
    <iisnode
      watchedFiles="web.config;*.js"
      loggingEnabled="true"
      logDirectory="iisnode"
      flushResponse="true"
      devErrorsEnabled="true"
    />
    <httpErrors existingResponse="PassThrough" />
  </system.webServer>
</configuration>
